# Magazine plan (~15 min, operator at the library): a daemon changer move waits out an open
# magazine instead of failing (changer not-ready wait, 2026-10-31). Interactive: the
# magazine leg asks the operator to pull one magazine out and push it back in, at the
# tmux window. Precondition: the four barcodes are in storage slots of the plan's library
# and one drive bay is empty. No tape is written; one tape is loaded and unloaded.
PLAN_NAME=magazine
PLAN_LIBRARY=DEC418146K_LL01
export FIELD_MIN_DRIVES=1
PLAN_ALLOWLIST="AOX032L9 AOX036L9 AOX038L9 AOX058L9"
PLAN_LEGS=(
  "fatal 00-preflight.sh"
  "fatal 03-bringup.sh"
  "fatal 02-discovery.sh"
  "fatal 36-magazine-wait.sh"
  "fatal 03-bringup.sh --stop"
  "continue 33-diag-capture.sh --note magazine-plan"
)
