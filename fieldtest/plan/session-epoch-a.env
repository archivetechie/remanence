  "fatal 41-session-closeout.sh failed-append --barcode AOX038L9"
  "fatal 41-session-closeout.sh measure-full-epoch --barcode AOX058L9"
  "fatal 41-session-closeout.sh measure-full-epoch --barcode AOX058L9 --live-control"
