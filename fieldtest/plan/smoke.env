# Smoke plan (~30 min): proves the owner-run mechanics on the LL01 partition.
# Legs run in order; "fatal" stops the plan and tears down, "continue" records and goes on.
PLAN_NAME=smoke
PLAN_LIBRARY=DEC418146K_LL01
PLAN_ALLOWLIST="AOX032L9 AOX036L9 AOX038L9 AOX058L9"
PLAN_LEGS=(
  "fatal 00-preflight.sh"
  "fatal 09-media-ready.sh --count 4 --no-wait"
  "fatal 03-bringup.sh"
  "fatal 02-discovery.sh"
  "fatal 11-happy-path.sh"
  "continue 33-diag-capture.sh --note smoke-plan-baseline"
)
