# Restore an older state copy, prove the pinned append is refused, then recover
# with the newer copy. Requires existing appendable fieldtest-a scratch media.
# Sourced by run.sh, which consumes these plan variables.
# shellcheck disable=SC2034
PLAN_NAME=restore-tail
PLAN_LIBRARY=DEC418146K_LL01
export FIELD_MIN_DRIVES=1
PLAN_ALLOWLIST="AOX032L9 AOX036L9 AOX038L9 AOX058L9"
PLAN_LEGS=(
  "fatal 00-preflight.sh"
  "fatal 09-media-ready.sh --count 4 --no-wait"
  "fatal 03-bringup.sh"
  "fatal 02-discovery.sh"
  "fatal 14-restore-tail.sh"
  "fatal 03-bringup.sh --stop"
  "continue 33-diag-capture.sh --note restore-tail-baseline"
)
