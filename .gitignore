/target/
**/*.rs.bk
Cargo.lock.bak
__pycache__/
*.py[cod]

# Editor swap/backup files
*.swp
*.swo
*~

# OS
.DS_Store

# Local-only secrets / state
.env
.envrc.local
.claude/scheduled_tasks.lock

# Devloop dispatcher runtime state (locks + per-entry dispatch markers).
# The journal/*.json files ARE the tracked handoff channel; .dispatch is transient.
journal/.dispatch/

# Locally downloaded standards references. Keep source URLs/checksums in docs.
docs/reference/posix/*.html

# Local SCSI dump captured during hardware work; keep curated references under docs/.
lto.txt

# Quadstor patch artifacts (the live tree under /quadstorvtl is not in this repo)
patches/**/originals/

# Fixtures: keep .bin / .txt; ignore any captured personal traces
fixtures/**/*.log

# Raw real-hardware capture bundles live alongside their extracted form.
# Keep the extracted directory tracked (it's how the parsers consume them);
# the tarball is redundant and large.
fixtures/real-hardware/*.tar.gz
verif/**/target/
verif/**/*.llbc
verif/**/lean/.lake/
verif/**/.leanstral/
fieldtest/tools/remfield-io/target/

# Internal working files — present locally, not part of the public repo
/journal/
CLAUDE.md
AGENTS.md
.claude/

# Fuzz campaign corpus growth. The deterministic seeds are reproducible from
# the pinned vector archive via tools/seed_rem_parity_fuzz_corpora.sh; the
# millions of mutants a campaign accumulates are not worth carrying in a
# specification repository (the 2026-07-30 structured campaign alone grew the
# corpus to 150 MB across ~27,000 files, and every campaign adds more).
# Campaign EVIDENCE lives in fuzz/reports/, which is committed: parameters,
# execution counts, coverage before/after, and any artifact analysis.
# Files already tracked before this rule stay tracked; this stops the growth.
fuzz/corpus/
